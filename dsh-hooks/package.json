{
  "name": "@local/dsh-hooks",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "description": "User-level hooks for DeepSeek Harness: a hooks.json turns lifecycle events into shell checks that can deny, ask, or annotate tool calls without writing a plugin.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "examples/*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
