{
  "name": "@local/dsh-verify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Detect and run the workspace's check command (test/lint/typecheck) and report a human summary with the failing lines.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
