{
  "name": "@local/dsh-skill-usage",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "description": "Tracks skill usage across sessions and flags stale skills that need review.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "index.js"
}
