{
  "name": "@local/dsh-notify",
  "version": "0.1.3",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "description": "Desktop notifications for long-running or failed agent turns (Windows toast + sound), plus a notify tool the agent can call to ping the human mid-task.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "index.js"
}
