{
  "name": "@local/dsh-checkpoint",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "description": "Write-before snapshots and one-call rollback for agent file edits.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
