{
  "name": "@local/dsh-history",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Search and read past session logs: full-text over local session history, with titles, workspaces and snippets.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
