{
  "name": "@local/dsh-browser-bundle",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "main": "index.js",
  "description": "Mounts browser-use with the Playwright MCP backend riding the local Edge/Chromium.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-browser-use": "0.2.2-rc.1",
    "@deepseek-ai/dsh-experimental-browser-use-playwright-mcp": "0.2.2-rc.1"
  }
}
