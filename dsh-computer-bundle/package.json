{
  "name": "@local/dsh-computer-bundle",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "main": "index.js",
  "description": "Mounts computer-use with the Cua Driver native backend for desktop window, mouse and keyboard control.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-computer-use": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "0.2.1-rc.5"
  }
}
