{
  "name": "@local/dsh-eventlog",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "description": "Local event log on D: (Windows Event Viewer style) — channels, levels, stable event codes, on-demand query, never injected into the prompt.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
