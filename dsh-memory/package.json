{
  "name": "@local/dsh-memory",
  "version": "4.16.0",
  "private": true,
  "engines": {
    "node": ">=23.4.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "type": "module",
  "description": "Persistent memory across sessions: agent-curated facts injected into the system prompt, editable with memory tools.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "index.js"
}
