{
  "name": "@local/dsh-memory",
  "version": "3.11.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "description": "Persistent memory across sessions: agent-curated facts injected into the system prompt, editable with memory tools.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
